{
    "$Comment": "[HYTAME] Add breeding interaction to tamed livestock",
    "_BaseAssetPath": "Server/NPC/Roles/_Core/Templates/Template_Livestock.json",
    "_priority": 100,
    "InteractionInstruction": {
        "Instructions": [
            {
                "_find": { "Enabled": { "Compute": "IsPettable" } },
                "_op": "addAfter",
                "Enabled": { "Compute": "!isEmptyStringArray(AttractiveItemSet)" },
                "TreeMode": true,
                "$Comment": "[HYTAME] Breeding: requires AttractiveItemSet + no breed cooldown",
                "Instructions": [
                    {
                        "InvertTreeModeResult": true,
                        "$Comment": "Bail out if breed cooldown active or player lacks AttractiveItemSet",
                        "Sensor": {
                            "Type": "Not",
                            "Sensor": {
                                "Type": "And",
                                "Sensors": [
                                    {
                                        "Type": "Alarm",
                                        "Name": "Breed_Cooldown",
                                        "State": "Unset"
                                    },
                                    {
                                        "Type": "Target",
                                        "TargetSlot": "InteractionTarget",
                                        "Filters": [
                                            {
                                                "Type": "ItemInHand",
                                                "Hand": "Main",
                                                "Items": { "Compute": "AttractiveItemSet" }
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        "Actions": [{ "Type": "Nothing" }]
                    },
                    {
                        "InvertTreeModeResult": true,
                        "Continue": true,
                        "$Comment": "Show breeding interaction hint",
                        "Sensor": { "Type": "Any" },
                        "Actions": [
                            { "Type": "SetInteractable", "Interactable": true, "ShowPrompt": true }
                        ]
                    },
                    {
                        "$Comment": "Execute breeding on interaction",
                        "Sensor": { "Type": "HasInteracted" },
                        "Actions": [
                            { "Type": "HyTameFeedInteraction" }
                        ]
                    }
                ]
            }
        ]
    }
}
