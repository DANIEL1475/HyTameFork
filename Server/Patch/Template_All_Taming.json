{
    "$Comment": "Add taming/feeding support to all templates (except Animal_Neutral which has its own handling)",
    "_BaseAssetPath": "regex:Server/NPC/Roles/_Core/Templates/Template_(?!Animal_Neutral\\b|Livestock\\b).+\\.json",
    "_priority": 100,
    "Parameters": {
        "AttractiveItemSet": {
            "Value": [],
            "TypeHint": "String",
            "Description": "Items that can be used to tame/feed this creature"
        }
    },
    "InteractionInstruction": {
        "Enabled": { "Compute": "!isEmptyStringArray(AttractiveItemSet)" },
        "Instructions": [
            {
                "$Comment": "Block for simple creatures (not mountable, not harvestable)",
                "Enabled": { "Compute": "!isEmptyStringArray(AttractiveItemSet)" },
                "Instructions": [
                    {
                        "$Comment": "Default interactable off — overridden by taming/breeding hints when conditions match",
                        "Continue": true,
                        "Sensor": { "Type": "Any" },
                        "Actions": [
                            { "Type": "SetInteractable", "Interactable": false }
                        ]
                    },
                    {
                        "$Comment": "Taming hint: Wild + IsTameable + player has AttractiveItemSet",
                        "Continue": true,
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                { "Type": "IsTameable", "Set": true },
                                { "Type": "Not", "Sensor": { "Type": "Tamed", "Set": true } },
                                {
                                    "Type": "Player",
                                    "Range": 5,
                                    "Filters": [{ "Type": "ItemInHand", "Items": { "Compute": "AttractiveItemSet" } }]
                                }
                            ]
                        },
                        "Actions": [
                            { "Type": "SetInteractable", "Interactable": true, "ShowPrompt": true }
                        ]
                    },
                    {
                        "$Comment": "Breeding hint: Tamed + player has AttractiveItemSet",
                        "Continue": true,
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                { "Type": "Tamed", "Set": true },
                                {
                                    "Type": "Player",
                                    "Range": 5,
                                    "Filters": [{ "Type": "ItemInHand", "Items": { "Compute": "AttractiveItemSet" } }]
                                }
                            ]
                        },
                        "Actions": [
                            { "Type": "SetInteractable", "Interactable": true, "ShowPrompt": true }
                        ]
                    },
                    {
                        "$Comment": "Execute taming/breeding action on F-key",
                        "Sensor": { "Type": "HasInteracted" },
                        "Actions": [
                            { "Type": "HyTameFeedInteraction" }
                        ]
                    }
                ]
            }
        ]
    }
}
